{%- comment -%}
  Icon set — ultra-light 1.25 stroke, single 24×24 viewBox.
  Usage: {% render 'icon', name: 'arrow', class: 'foo' %}
  ponytail: one snippet, one viewBox. No icon library, no 300KB of unused paths.
{%- endcomment -%}

{%- liquid
  assign s = class | default: ''
-%}

{%- case name -%}
  {%- when 'arrow' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'bag' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'search' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  {%- when 'user' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c0-3.6 3.1-5.5 7-5.5s7 1.9 7 5.5"/></svg>
  {%- when 'close' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.5 2 4 4.5 4.2"/></svg>
  {%- when 'pinterest' -%}
    <svg class="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M10 20l2-7"/><path d="M9.5 10.5c0-1.7 1.4-3 3.2-3s3 1.1 3 2.9c0 2-1.2 3.6-2.8 3.6-.9 0-1.6-.7-1.4-1.6"/></svg>
{%- endcase -%}
