{%- paginate collection.products by 24 -%}
  <div class="container">
    <header class="coll-head">
      <div style="display:flex;flex-direction:column;gap:1.5rem;align-items:flex-start">
        <span class="eyebrow">
          <span class="kanji" aria-hidden="true">{{ section.settings.kanji | default: '蔵' }}</span>
          Collection
        </span>
        <h1 class="section-title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="lede">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </header>

    <div class="coll-bar">
      <span class="coll-bar__count">
        {{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}
      </span>

      {%- comment -%}
        Sort only. ponytail: faceted filters are a Search & Discovery app feature —
        add them when the catalogue is big enough to need them, not before.
      {%- endcomment -%}
      <form method="get" style="display:flex;align-items:center;gap:.75rem">
        <label class="coll-bar__count" for="sort">Sort</label>
        <select
          id="sort"
          name="sort_by"
          onchange="this.form.submit()"
          style="padding:.5rem .75rem;background:transparent;border:1px solid var(--line);border-radius:999px;font-size:var(--t-xs);color:var(--bone)"
        >
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by or option.value == collection.default_sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
        <noscript><button class="chip" type="submit">Apply</button></noscript>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="card-grid">
        {%- for product in collection.products -%}
          {% render 'product-card',
            product: product,
            index: forloop.index0,
            sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw'
          %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="{% if part.title == paginate.current_page %}is-current{% endif %}" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>
                {{- part.title -}}
              </span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="Next page">→</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <span class="kanji" aria-hidden="true">空</span>
        <p>Nothing in this collection yet.</p>
        <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">
          <span>Browse everything</span>
          <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "text", "id": "kanji", "label": "Eyebrow kanji", "default": "蔵" }]
}
{% endschema %}
