{%- comment -%}
  404 — must return a real 404 status (Shopify handles that) and always
  offer a route back. A dead end here is a lost customer.
{%- endcomment -%}

<section class="band" style="min-height:80vh">
  <div class="band__wash" aria-hidden="true"></div>

  <div class="container band__inner">
    <span class="kanji" aria-hidden="true" style="font-size:clamp(5rem,18vw,12rem);opacity:.14">迷</span>
    <span class="eyebrow">Error 404</span>
    <h1 class="section-title" style="max-width:14ch">{{ section.settings.heading | default: 'Lost in the dark' }}</h1>
    <p class="lede" style="text-align:center">
      {{ section.settings.body | default: 'This page does not exist, or it has been taken down. Everything still standing is below.' }}
    </p>

    <div style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center">
      <a class="btn btn--lg" href="{{ routes.all_products_collection_url }}">
        <span>Shop everything</span>
        <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
      </a>
      <a class="btn btn--lg btn--ghost" href="{{ routes.root_url }}">
        <span>Home</span>
        <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lost in the dark" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ]
}
{% endschema %}
