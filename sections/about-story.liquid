<section class="section">
  <div class="container">
    <div class="split" style="align-items:center">
      <div class="split__a reveal">
        <div style="display:flex;flex-direction:column;gap:1.75rem;align-items:flex-start">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">
              <span class="kanji" aria-hidden="true">{{ section.settings.kanji | default: '物' }}</span>
              {{ section.settings.eyebrow }}
            </span>
          {%- endif -%}

          <h2 class="section-title">{{ section.settings.heading }}</h2>

          {%- if section.settings.body != blank -%}
            <div class="prose">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.link_label != blank -%}
            <a class="btn btn--ghost" href="{{ section.settings.link_url }}">
              <span>{{ section.settings.link_label }}</span>
              <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="split__b reveal" data-delay="2">
        <div class="bezel">
          <div class="bezel__core">
            {% render 'placeholder-media',
              image: section.settings.image,
              ratio: 'tall',
              sizes: '(min-width: 768px) 40vw, 100vw',
              label: section.settings.image_label
            %}
          </div>
        </div>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="card-grid" style="margin-top:clamp(4rem,8vw,7rem)">
        {%- for block in section.blocks -%}
          <div class="bezel reveal" data-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
            <div class="bezel__core" style="padding:2rem;display:flex;flex-direction:column;gap:.875rem">
              <span class="kanji" aria-hidden="true" style="font-size:2rem;opacity:.3">{{ block.settings.kanji }}</span>
              <h3 style="font-size:var(--t-md);font-weight:500">{{ block.settings.heading }}</h3>
              <p style="color:var(--mute);font-size:var(--t-sm);line-height:1.7">{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The brand" },
    { "type": "text", "id": "kanji", "label": "Kanji", "default": "物" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the hours after dark" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "Atelier" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "kanji", "label": "Kanji", "default": "質" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heavyweight only" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "pillar", "settings": { "kanji": "質", "heading": "Heavyweight only", "body": "480gsm loopback cotton, garment-dyed and washed until it moves like something you have owned for years." } },
        { "type": "pillar", "settings": { "kanji": "限", "heading": "Small runs", "body": "Each piece is cut in limited quantities. We do not restock — a sold size stays sold." } },
        { "type": "pillar", "settings": { "kanji": "黒", "heading": "One colour", "body": "Everything is black. Washed, faded, distressed — but always black. The silhouette does the talking." } }
      ]
    }
  ]
}
{% endschema %}
