{%- comment -%}
  Generic page template — powers Shipping & Returns, Privacy, Terms and any
  other prose page. One section, every static page.
{%- endcomment -%}

<div class="container container--tight" style="padding-top:clamp(9rem,16vw,13rem);padding-bottom:var(--pad-section)">
  <header style="display:flex;flex-direction:column;gap:1.5rem;align-items:flex-start;margin-bottom:3.5rem">
    {%- if section.settings.kanji != blank -%}
      <span class="eyebrow">
        <span class="kanji" aria-hidden="true">{{ section.settings.kanji }}</span>
        {{ page.title }}
      </span>
    {%- endif -%}
    <h1 class="section-title">{{ page.title }}</h1>
  </header>

  <div class="prose">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [{ "type": "text", "id": "kanji", "label": "Eyebrow kanji", "default": "文" }]
}
{% endschema %}
