{%- liquid
  assign current = product.selected_or_first_available_variant
  assign fallback_label = product.type | default: 'Noctairre'
-%}

<div class="container">
  <div class="pdp" data-variant-picker data-money-format="{{ shop.money_format | escape }}">
    {%- comment -%} ------------------------------ Media ------------------------------ {%- endcomment -%}
    <div class="pdp__media">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media limit: 5 -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <div class="bezel">
            <div class="bezel__core">
              {% render 'placeholder-media',
                image: media.preview_image,
                ratio: 'portrait',
                sizes: '(min-width: 900px) 55vw, 100vw',
                eager: forloop.first,
                alt: media_alt
              %}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="bezel">
            <div class="bezel__core">
              {% render 'placeholder-media',
                ratio: 'portrait',
                label: fallback_label
              %}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} ------------------------------ Info ------------------------------- {%- endcomment -%}
    <div class="pdp__info">
      <div style="display:flex;flex-direction:column;gap:1.25rem;align-items:flex-start">
        {%- if product.type != blank -%}
          <span class="eyebrow">
            <span class="kanji" aria-hidden="true">夜</span>
            {{ product.type }}
          </span>
        {%- endif -%}

        <h1 class="pdp__title">{{ product.title }}</h1>

        <p class="pdp__price">
          <s data-variant-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %} style="color:var(--mute);margin-right:.5rem">
            {{- current.compare_at_price | money -}}
          </s>
          <span data-variant-price>{{ current.price | money }}</span>
        </p>
      </div>

      <form data-add-form action="{{ routes.cart_add_url }}" method="post" style="margin-top:2rem">
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        {%- comment -%}
          Variant map for the picker. Only id/options/price/availability —
          nothing that isn't already visible on the page.
        {%- endcomment -%}
        <script type="application/json" data-variant-json>
          [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id }},
                "options": {{ v.options | json }},
                "price": {{ v.price }},
                "compare_at_price": {{ v.compare_at_price | default: 0 }},
                "available": {{ v.available }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pdp__row">
              <div class="opt__label">
                <span>{{ option.name }}</span>
                {%- assign lowered = option.name | downcase -%}
                {%- if lowered contains 'size' and section.settings.size_guide != blank -%}
                  <a class="link-underline" href="{{ section.settings.size_guide }}">Size guide</a>
                {%- endif -%}
              </div>

              <fieldset class="opt__set">
                <legend>{{ option.name }}</legend>
                {%- for value in option.values -%}
                  {%- liquid
                    assign input_id = 'opt-' | append: option.position | append: '-' | append: forloop.index
                    assign is_available = false
                    for v in product.variants
                      assign opt_key = 'option' | append: option.position
                      if v[opt_key] == value and v.available
                        assign is_available = true
                        break
                      endif
                    endfor
                  -%}
                  <input
                    class="opt__input"
                    type="radio"
                    id="{{ input_id }}"
                    name="option-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-index="{{ option.position | minus: 1 }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    {% unless is_available %}disabled{% endunless %}
                  >
                  <label class="opt__chip" for="{{ input_id }}">
                    {{- value -}}
                    {%- unless is_available -%}<span class="visually-hidden"> — sold out</span>{%- endunless -%}
                  </label>
                {%- endfor -%}
              </fieldset>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <p class="form-note form-note--error" data-add-error role="alert" hidden style="margin-top:1.5rem"></p>

        <button
          class="btn btn--block btn--lg"
          type="submit"
          data-add-btn
          style="margin-top:1.75rem"
          {% unless current.available %}aria-disabled="true"{% endunless %}
        >
          <span data-add-label>{% if current.available %}Add to bag{% else %}Sold out{% endif %}</span>
          <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
        </button>
      </form>

      {%- comment -%} ---------------------------- Details ---------------------------- {%- endcomment -%}
      <div style="margin-top:2.5rem">
        {%- if product.description != blank -%}
          <div class="accordion">
            <button class="accordion__trigger" type="button" data-accordion aria-expanded="true" aria-controls="acc-desc">
              Description
              {% render 'icon', name: 'plus' %}
            </button>
            <div class="accordion__panel" id="acc-desc">
              <div><div class="accordion__body prose">{{ product.description }}</div></div>
            </div>
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.body != blank -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <button
                class="accordion__trigger"
                type="button"
                data-accordion
                aria-expanded="false"
                aria-controls="acc-{{ block.id }}"
              >
                {{ block.settings.heading }}
                {% render 'icon', name: 'plus' %}
              </button>
              <div class="accordion__panel" id="acc-{{ block.id }}">
                <div><div class="accordion__body prose">{{ block.settings.body }}</div></div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} ------------------------------ Related ------------------------------ {%- endcomment -%}
{%- if section.settings.show_related -%}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow reveal"><span class="kanji" aria-hidden="true">他</span> More from Noctairre</span>
      </div>
      <div class="card-grid">
        {%- assign related = collections[product.collections.first.handle].products | default: collections.all.products -%}
        {%- assign shown = 0 -%}
        {%- for item in related -%}
          {%- if item.id != product.id and shown < 4 -%}
            {% render 'product-card', product: item, index: shown, sizes: '(min-width: 768px) 25vw, 50vw' %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "url", "id": "size_guide", "label": "Size guide page" },
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fit & fabric" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
