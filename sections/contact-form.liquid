<section class="section" style="padding-top:clamp(9rem,16vw,13rem)">
  <div class="container container--tight">
    <div class="split" style="gap:clamp(2.5rem,5vw,4rem)">
      <div class="split__a">
        <div style="display:flex;flex-direction:column;gap:1.5rem;align-items:flex-start">
          <span class="eyebrow"><span class="kanji" aria-hidden="true">問</span> Contact</span>
          <h1 class="section-title">{{ section.settings.heading | default: 'Get in touch' }}</h1>
          {%- if section.settings.body != blank -%}
            <div class="prose">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
            <p class="form-note">
              Prefer email?
              <a class="link-underline" href="mailto:{{ section.settings.email }}" style="color:var(--bone)">
                {{- section.settings.email -}}
              </a>
            </p>
          {%- endif -%}
        </div>
      </div>

      <div class="split__b">
        <div class="bezel">
          <div class="bezel__core" style="padding:clamp(1.5rem,4vw,2.5rem)">
            {%- form 'contact' -%}
              {%- if form.posted_successfully? -%}
                <p class="form-note" role="status" style="margin-bottom:1.5rem">
                  Thank you — we reply within two business days.
                </p>
              {%- elsif form.errors -%}
                <p class="form-note form-note--error" role="alert" style="margin-bottom:1.5rem">
                  {{ form.errors | default_errors }}
                </p>
              {%- endif -%}

              <div style="display:flex;flex-direction:column;gap:1.25rem">
                <div class="field">
                  <label for="contact-name">Name</label>
                  <input id="contact-name" type="text" name="contact[name]" autocomplete="name" required aria-required="true">
                </div>

                <div class="field">
                  <label for="contact-email">Email</label>
                  <input id="contact-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true">
                </div>

                <div class="field">
                  <label for="contact-order">Order number <span style="text-transform:none;letter-spacing:0">(optional)</span></label>
                  <input id="contact-order" type="text" name="contact[order]" inputmode="numeric">
                </div>

                <div class="field">
                  <label for="contact-body">Message</label>
                  <textarea id="contact-body" name="contact[body]" rows="6" required aria-required="true"></textarea>
                </div>

                <button class="btn btn--block btn--lg" type="submit">
                  <span>Send message</span>
                  <span class="btn__orb" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
                </button>
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "email", "label": "Public email address" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
