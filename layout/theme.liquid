<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#050505">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- else -%}
      {%- comment -%} 夜 mark as an inline data-URI favicon — no asset request. {%- endcomment -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23050505'/%3E%3Ctext x='32' y='47' font-family='serif' font-size='46' fill='%23F4F2ED' text-anchor='middle'%3E%E5%A4%9C%3C/text%3E%3C/svg%3E">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    >

    <title>
      {{ page_title }}
      {%- if current_tags %} &mdash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &mdash; {{ 'general.page' | t }} {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &mdash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'noctairre.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      // Gate the cinematic intro to once per session so repeat views stay instant.
      if (sessionStorage.getItem('noctairre:seen') === '1') {
        document.documentElement.classList.add('intro-done');
      }
    </script>
  </head>

  <body class="template--{{ template.name | handle }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% render 'intro-veil' %}
    {% render 'petals' %}
    {% render 'grain' %}

    {% sections 'header-group' %}

    <main id="main" class="page-shell" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script src="{{ 'noctairre.js' | asset_url }}" defer></script>
  </body>
</html>
